{
  "title": "cAdvisor Containers Overview",
  "rows": [
    {
      "title": "Container Health",
      "panels": [
        {
          "title": "Containers Seen",
          "width": 6,
          "expr": [
            "count(container_last_seen{id!=\"/\"})"
          ]
        },
        {
          "title": "Top 10 CPU Cores Used",
          "width": 6,
          "expr": [
            "topk(10, sum by(id) (rate(container_cpu_usage_seconds_total{id!=\"/\"}[5m])))"
          ]
        },
        {
          "title": "Top 10 Memory Working Set",
          "width": 6,
          "expr": [
            "topk(10, max by(id) (container_memory_working_set_bytes{id!=\"/\"}))"
          ]
        },
        {
          "title": "Container Uptime (seconds)",
          "width": 6,
          "expr": [
            "topk(10, time() - max by(id) (container_start_time_seconds{id!=\"/\"}))"
          ]
        }
      ]
    },
    {
      "title": "Container IO",
      "panels": [
        {
          "title": "Top 10 Network RX/TX Bytes/s",
          "width": 6,
          "expr": [
            "topk(10, sum by(id) (rate(container_network_receive_bytes_total{id!=\"/\"}[5m])))",
            "topk(10, sum by(id) (rate(container_network_transmit_bytes_total{id!=\"/\"}[5m])))"
          ],
          "alias": [
            "{{id}} rx",
            "{{id}} tx"
          ]
        },
        {
          "title": "Top 10 FS Read/Write Bytes/s",
          "width": 6,
          "expr": [
            "topk(10, sum by(id) (rate(container_fs_reads_bytes_total{id!=\"/\"}[5m])))",
            "topk(10, sum by(id) (rate(container_fs_writes_bytes_total{id!=\"/\"}[5m])))"
          ],
          "alias": [
            "{{id}} read",
            "{{id}} write"
          ]
        }
      ]
    }
  ]
}
